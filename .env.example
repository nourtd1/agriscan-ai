# Copy this file to .env and fill in real values. Never commit .env.
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase — find these in your project's Settings > API page
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Edge Function secrets — set via CLI, never put in this file:
#   supabase secrets set GEMINI_API_KEY=<your-key>
# The variables below are only needed if running `supabase functions serve` locally.
# SUPABASE_SERVICE_ROLE_KEY is auto-injected in production; add it here for local dev only.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
